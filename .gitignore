# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
*.env.local

# Database & local session data
.termux_agent_data/
workspaces/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm

# Log files
*.log

# Temporary files
.tmp/
.DS_Store

# Frontend build tooling (the built bundle in web/static IS committed so the
# Python app keeps working with zero Node/Python dependencies at runtime)
frontend/node_modules/
web/static/*.map
